{
  "name": "antpix",
  "version": "0.2.1",
  "private": true,
  "description": "生态蚂蚁窝 · 微信小游戏",
  "uuid": "9f5b4c3e-17b6-4dfa-8311-ae0b9c7f7820",
  "creator": {
    "version": "3.8.8"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --suppressions-location eslint-baseline.json",
    "check": "npm run format:check && npm run lint && npm run check:architecture && npm run prepare:cloud && npm test && npm run typecheck && npm run check:ui",
    "prepare:cloud": "node --experimental-strip-types --import ./scripts/register-typescript.mjs scripts/prepare-cloud.mjs",
    "test": "node --experimental-strip-types --import ./scripts/register-typescript.mjs --test tests/*.test.mjs",
    "build:wechat": "node scripts/build.mjs",
    "typecheck": "node scripts/typecheck.mjs",
    "check:ui": "node scripts/check-font-coverage.cjs && node scripts/check-ui.cjs && node scripts/check-container-launch.cjs && node scripts/check-predictive-dispatch.cjs && node scripts/check-level-picker.cjs",
    "check:built": "node scripts/check-built.cjs && CHECK_BUILT=1 node scripts/check-ui.cjs",
    "generate:containers": "node --experimental-strip-types --import ./scripts/register-typescript.mjs scripts/generate-container-plans.mjs",
    "bench:animation": "ANT_ATLAS=1 node scripts/bench-animation.cjs",
    "bench:dispatch": "node scripts/bench-dispatch.cjs",
    "generate:ants": "node scripts/generate-ant-atlas.cjs",
    "preversion": "npm run check",
    "lint:all": "eslint .",
    "evaluate:containers": "node --experimental-strip-types --import ./scripts/register-typescript.mjs scripts/evaluate-container-plans.mjs",
    "check:containers": "node scripts/check-container-gameplay.cjs",
    "check:architecture": "node scripts/check-architecture.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2"
  }
}
